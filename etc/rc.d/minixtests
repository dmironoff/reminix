#!/bin/sh
#
# ReMinix: unattended regression test run for automated testing under QEMU
# (docker/build.mk, target test-i386; docs/testing.md).
#
# Does nothing unless the kernel command line contains testrun=1. Then it
# runs the minix-posix suite in TAP mode on the console, prints begin/end
# markers for the host-side parser and powers the machine off.
#
#   testrun=1            enable
#   testlist=43,71,sh1   optional: run only these tests (comma separated,
#                        names as accepted by "run -t")
#   testdelay=N          optional: seconds to wait before starting (30)
#   testjobs=N           optional: take the tests of the list
#                        N at a time and run each group concurrently (stress;
#                        a test may be listed several times). Each slot runs
#                        in its own directory of symbolic links to the suite,
#                        so copies of one test do not share DIR_xx. Results
#                        of a group are printed when the whole group is done.
#   testtimes=N          optional: run every test of the list (all tests if
#                        there is no testlist) N times
#   testrandom=SEED      optional: shuffle that list (awk srand(SEED)), so that
#                        with testjobs different tests meet in one group; the
#                        same SEED gives the same order. Each group is printed
#                        as a TAP comment before it starts.
#
# Runs synchronously as the last rc script: getty is started by init only
# after rc has finished, and getty revokes the console, so output of a
# background job would be lost. The delay lets the system settle after
# all daemons have started (devmand, syslogd, cron, inetd): tests walking
# the whole file system (test43) fail if files vanish under them.

# PROVIDE: minixtests
# REQUIRE: LOGIN inetd local

$_rc_subr_loaded . /etc/rc.subr

name="minixtests"
start_cmd="minixtests_start"
stop_cmd=":"

# Run "$list" in groups of $jobs concurrent tests (testjobs=N), after
# repeating it $times times and shuffling it with seed $seed if requested.
minixtests_parallel()
{
	base=/usr/tests/minix-posix
	jobs=${jobs:-1}

	[ -n "$list" ] || list="`cd $base && ./run -l`"
	if [ "${times:-1}" -gt 1 ]; then
		one="$list"
		list=
		i=0
		while [ $i -lt $times ]; do
			i=$((i + 1))
			list="$list $one"
		done
	fi
	if [ -n "$seed" ]; then
		echo "# minixtests: random order, seed $seed"
		list="`for t in $list; do echo $t; done |
		    awk -v seed=$seed 'BEGIN { srand(seed) }
			{ printf "%.9f %s\n", rand(), $0 }' |
		    sort -n | awk '{ print $2 }'`"
	fi

	n=0
	for t in $list; do n=$((n + 1)); done
	echo "1..$n"

	k=0
	while [ $k -lt $jobs ]; do
		k=$((k + 1))
		d=$base.job$k
		rm -rf $d
		mkdir $d || return 127
		chown "`stat -f %Su:%Sg $base`" $d
		chmod "`stat -f %Lp $base`" $d
		for f in $base/* $base/.[!.]*; do
			[ -e "$f" ] && ln -s "$f" $d/
		done
	done

	# Background jobs of a shell without job control get /dev/null as
	# standard input; tests want the console there (test3: ttyname(0)).
	# Hand it over through fd 3, which the tests must not see open.
	exec 3<&0
	status=0
	g=0
	set -- $list
	while [ $# -gt 0 ]; do
		g=$((g + 1))
		echo "# minixtests: group $g:" `echo "$@" | cut -d' ' -f1-$jobs`
		k=0
		while [ $k -lt $jobs ] && [ $# -gt 0 ]; do
			k=$((k + 1))
			d=$base.job$k
			( cd $d && ./run -T -t "$1" <&3 3<&- > $d/.out 2>&1
			  echo $? > $d/.status ) &
			shift
		done
		wait
		i=0
		while [ $i -lt $k ]; do
			i=$((i + 1))
			d=$base.job$i
			grep -v '^1\.\.' $d/.out
			[ "`cat $d/.status`" = 0 ] || status=1
		done
	done
	exec 3<&-
	return $status
}

minixtests_start()
{
	[ "`/bin/sysenv testrun 2>/dev/null`" = "1" ] || return 0

	list="`/bin/sysenv testlist 2>/dev/null | tr ',' ' '`"
	delay="`/bin/sysenv testdelay 2>/dev/null`"
	jobs="`/bin/sysenv testjobs 2>/dev/null`"
	times="`/bin/sysenv testtimes 2>/dev/null`"
	seed="`/bin/sysenv testrandom 2>/dev/null`"

	echo "minixtests: starting in ${delay:-30}s"
	sleep ${delay:-30}

	echo "REMINIX-TESTS-BEGIN"
	if [ "${jobs:-1}" -gt 1 ] || [ "${times:-1}" -gt 1 ] ||
	    [ -n "$seed" ]; then
		minixtests_parallel
		status=$?
	elif cd /usr/tests/minix-posix; then
		if [ -n "$list" ]; then
			./run -T -t "$list"
		else
			./run -T
		fi
		status=$?
	else
		status=127
	fi
	echo "REMINIX-TESTS-END status=$status"

	# Let TTY drain its output queue to the (slow) serial line before
	# powering off, otherwise the last lines are lost.
	sleep 5
	sync
	/sbin/halt -p
}

load_rc_config $name
run_rc_command "$1"
