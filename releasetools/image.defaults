: ${OBJ=../obj.${ARCH}}
: ${CROSS_TOOLS=${OBJ}/"tooldir.`uname -s`-`uname -r`-`uname -m`"/bin}
: ${CROSS_PREFIX=${CROSS_TOOLS}/${TOOLCHAIN_TRIPLET}}
: ${JOBS=1}
: ${DESTDIR=${OBJ}/destdir.$ARCH}
: ${RELEASEDIR=${OBJ}/releasedir/$ARCH/binary}
: ${RELEASETOOLSDIR=./releasetools/}
: ${BUILDVARS=}

# boot.cfg of the x86 images (empty: as in MINIX)
#   BOOT_CONSOLE=com0  boot loader and MINIX console on the first serial port
#   BOOT_SMP=yes       SMP kernel: one more menu entry, one CPU (no_apic=1);
#                      by default yes when BUILDVARS has CONFIG_SMP=y
: ${BOOT_CONSOLE=}
case " ${BUILDVARS} " in
*CONFIG_SMP=y*)	: ${BOOT_SMP=yes} ;;
esac
: ${BOOT_SMP=no}
: ${CREATE_IMAGE_ONLY=0}
: ${RELEASE_VERSION=$(sh sys/conf/osrelease.sh)}

: ${WORK_DIR=${OBJ}/work}
: ${SETS_DIR=${OBJ}/releasedir/${ARCH}/binary/sets}

: ${PACKAGE_DIR=}
: ${PKG_INFO=pkg_info}
: ${BUNDLE_PACKAGES=}

: ${BUNDLE_SETS=0}

: ${RC=../local/rc.${ARCH}}
: ${ASR_HACK=0}

# where the kernel & boot modules will be
MODDIR=${DESTDIR}/boot/minix/.temp
