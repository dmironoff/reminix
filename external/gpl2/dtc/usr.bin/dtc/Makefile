#	$NetBSD: Makefile,v 1.4 2019/12/22 12:42:23 skrll Exp $

# Before <bsd.own.mk>: it sets NOMAN.
.include "${.CURDIR}/../Makefile.inc"

.include <bsd.own.mk>

PROG=	dtc

CPPFLAGS+=	-I${.CURDIR}

# DTC_SRCS of ${DTCDIST}/Makefile.dtc without yamltree.c (NO_YAML).  That file
# is written for GNU make (ifneq), so it is not included here; NetBSD patches
# it instead.
SRCS=	checks.c data.c dtc.c flattree.c fstree.c livetree.c srcpos.c \
	treesource.c util.c
# The parser and the lexer are generated by bison and flex at import time
# (dtc2reminix): the in-tree byacc does not implement %locations correctly.
SRCS+=	dtc-lexer.lex.c dtc-parser.tab.c

.include <bsd.prog.mk>
